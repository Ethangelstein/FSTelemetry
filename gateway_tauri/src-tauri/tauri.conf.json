{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gateway Tauri",
  "version": "0.1.0",
  "identifier": "com.example.gateway",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },

  "app": {
    "windows": [{"title": "Gateway", "width": 1200, "height": 800}]
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
