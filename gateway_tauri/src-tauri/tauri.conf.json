{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gateway Tauri",
  "version": "0.1.0",
  "identifier": "com.example.gateway",

  "build": {
    "beforeDevCommand": "npm run dev --prefix ../telemetry -- --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../telemetry",
    "frontendDist": "../telemetry/dist"
  },

  "app": {
    "windows": [{"title": "Gateway", "width": 1200, "height": 800}]
  },

  "bundle": {
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
